{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": ["backlog/**", "experiments/**", "scripts/**", "**/*.html"],
  "rules": {
    "no-debugger": "error",
    "no-console": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  }
}
