{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "lifecycle": {
    "id": "task-to-pr-review-cleanup",
    "source_of_truth": "repository-lifecycle-policy-and-orca-run",
    "run": {
      "required": true,
      "dispatch_required": true,
      "tracked_outcomes": ["succeeded", "failed"],
      "forbid_untracked_full_handoff": true,
      "persist_identifiers": [
        "task_id",
        "run_id",
        "dispatch_id",
        "worker_session_id",
        "worktree_id",
        "worktree_path",
        "branch"
      ]
    },
    "dispatch_selection": {
      "command": "pnpm run backlog:dispatchable",
      "source_of_truth": "backlog-cli",
      "required_status": "To Do",
      "requires_ready": true,
      "requires_leaf_task": true,
      "reject_if_has_subtasks": true,
      "selection_order": ["priority", "ordinal"],
      "max_tasks": 1,
      "no_candidate_action": "report_and_stop_before_run_or_dispatch"
    },
    "worktree_creation": {
      "single_flight": true,
      "poll_command_until_exit": true,
      "indeterminate_results": ["empty_output", "timeout", "runtime_unavailable"],
      "before_retry": ["orca_worktree_list", "git_worktree_list"],
      "retry_only_when_target_absent": true,
      "duplicate_policy": "stop_and_reconcile_exact_target"
    },
    "completion_modes": {
      "default": "manual_review",
      "automatic": {
        "enabled": true,
        "task_types": ["spike", "docs", "bug", "chore", "task"],
        "max_changed_files": 10,
        "max_changed_lines": 300,
        "requires_no_decision_changes": true,
        "requires_no_user_decision": true,
        "requires_no_public_api_changes": true,
        "requires_no_compatibility_changes": true,
        "requires_no_distribution_changes": true,
        "protected_paths": [
          "AGENTS.md",
          ".orca/**",
          ".github/**",
          "package.json",
          "pnpm-lock.yaml",
          "backlog/decisions/**",
          "CHANGELOG.md",
          "release/**"
        ],
        "requires_current_head_checks": true,
        "fallback": "manual_review"
      }
    },
    "coordinator": {
      "main_workspace_policy": "read_only_for_task_records",
      "require_clean_main_before_dispatch": true,
      "forbid_task_file_writes_from_main": true,
      "forbid_post_merge_backlog_updates": true,
      "task_record_owner": "worker_task_worktree_before_draft_pr",
      "sync_policy": "fetch_or_fast_forward_only_when_main_is_clean"
    },
    "states": {
      "initial": "dispatched",
      "success_path": [
        "dispatched",
        "completion_accepted",
        "task_validated",
        "draft_pr_ready",
        "awaiting_user_review",
        "approved",
        "checks_passed",
        "merged",
        "cleanup_pending",
        "completed"
      ],
      "automatic_success_path": [
        "dispatched",
        "completion_accepted",
        "task_validated",
        "draft_pr_ready",
        "checks_passed",
        "merged",
        "cleanup_pending",
        "completed"
      ],
      "retained_terminal_states": [
        "completion_failed",
        "pr_failed",
        "checks_failed",
        "changes_requested",
        "approval_rejected",
        "interrupted",
        "restart_recovery",
        "merge_unknown"
      ],
      "retained_artifacts": ["pull_request", "branch", "worktree", "logs"]
    },
    "completion": {
      "accepted_only_from_active_dispatch": true,
      "validate_backlog_task_before_pr": true,
      "required_task_record": [
        "completion_id",
        "outcome",
        "files_modified",
        "validation_commands",
        "validation_results"
      ],
      "duplicate_policy": "ignore_exact_replay_and_reconcile_state",
      "conflicting_replay_policy": "retain_artifacts_and_escalate"
    },
    "pull_request": {
      "draft": true,
      "one_per_task": true,
      "idempotency_marker": "<!-- lifecycle-task: {task_id} run: {run_id} -->",
      "lookup_order": ["idempotency_marker", "task_id_and_head_sha"],
      "required_body_fields": [
        "backlog_task",
        "run_id",
        "dispatch_id",
        "worktree_id",
        "summary",
        "files_modified",
        "validation_commands_and_results",
        "recovery_state"
      ],
      "body_encoding_policy": "body_file_or_actual_newlines",
      "reject_literal_backslash_n": true,
      "create_failure_policy": "retain_branch_worktree_logs_and_retry_same_marker"
    },
    "review_gate": {
      "required": true,
      "kind": "explicit_user_approval",
      "automatic_mode": {
        "enabled": true,
        "requires_eligibility": true,
        "approval_required": false,
        "fallback": "manual_review"
      },
      "approval_must_bind": [
        "task_id",
        "run_id",
        "dispatch_id",
        "pull_request_number",
        "head_sha"
      ],
      "pending_or_rejected_policy": "retain_all_review_artifacts",
      "forbid_merge_before_approval": true,
      "forbid_cleanup_before_approval_and_merge": true
    },
    "merge": {
      "required_approval": true,
      "required_checks": true,
      "checks_must_be_successful_for_current_head": true,
      "strategy": "repository-approved-strategy",
      "strategy_must_be_explicit": true,
      "allow_automatic_merge": true,
      "automatic_merge_requires_eligibility": true,
      "unknown_result_policy": "inspect_pr_before_retry_and_retain_artifacts"
    },
    "cleanup": {
      "trigger": "successful_merge_only",
      "scope": ["exact_worker_session", "exact_owned_worktree"],
      "require_identity_match": true,
      "release_operation": "dispatch-scoped-worker-release",
      "delete_unrelated_resources": false,
      "failure_or_interruption_policy": "retain_worker_session_worktree_branch_pr_and_logs",
      "branch_policy": "follow_approved_merge_strategy_only"
    },
    "idempotency": {
      "keys": [
        "task_id",
        "run_id",
        "dispatch_id",
        "completion_id",
        "pull_request_idempotency_marker",
        "head_sha"
      ],
      "state_transition_policy": "monotonic_or_explicit_recovery",
      "duplicate_pr_policy": "update_existing_marked_pr",
      "duplicate_merge_policy": "treat_already_merged_as_success_after_verification",
      "duplicate_cleanup_policy": "safe_noop_after_exact_resource_release"
    },
    "enforcement": {
      "repository_files_are": "declarative_policy_and_runbook",
      "requires_orca_runtime_for": [
        "run_and_dispatch_tracking",
        "worker_done_validation",
        "explicit_review_gate",
        "exact_worker_release"
      ],
      "requires_github_integration_for": [
        "draft_pr_creation_or_update",
        "required_check_status",
        "approved_merge"
      ],
      "not_claimed_as_automated": [
        "branch_protection_configuration",
        "user_identity_and_approval_authentication",
        "remote_pr_api_availability",
        "worktree_deletion_outside_orca"
      ]
    }
  }
}
